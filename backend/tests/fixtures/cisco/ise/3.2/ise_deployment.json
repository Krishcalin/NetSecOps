    {
      "rule": {
        "name": "Legacy printers",
        "rank": 2,
        "state": "disabled"
      },
      "profile": "PermitAccess"
    }
  ],
  "policy/device-admin/command-sets": [
    {
      "name": "ReadOnly-Commands",
      "permitUnmatched": false,
      "commands": {
        "commandList": [
          {
            "grant": "PERMIT",
            "command": "show",
            "arguments": ".*"
          },
          {
            "grant": "DENY",
            "command": "configure",
            "arguments": ".*"
          }
        ]
      }
    },
    {
      "name": "NetworkAdmin",
