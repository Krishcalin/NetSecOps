# NetSecOps API / worker image (SEC-10: non-root, minimal surface).
#
# Two stages so build tooling never reaches the runtime layer.

# ───────────────────────────── build stage ─────────────────────────────
FROM python:3.12-slim-bookworm AS build

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1

# build-essential and libpq-dev are needed to compile argon2-cffi and asyncpg wheels
# where a prebuilt wheel is unavailable for the target platform.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY backend/pyproject.toml ./
COPY backend/netsecops ./netsecops

RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip setuptools wheel \
    && /opt/venv/bin/pip install .

# ──────────────────────────── runtime stage ────────────────────────────
FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH"

# libpq5 only — the client library, not the build headers.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq5 tini \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 netsecops \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin netsecops

COPY --from=build /opt/venv /opt/venv

WORKDIR /app
COPY backend/alembic.ini ./
COPY backend/netsecops ./netsecops

USER 10001:10001
EXPOSE 8000

# tini reaps zombies and forwards signals, so a `docker stop` drains cleanly rather
# than severing in-flight device sessions.
ENTRYPOINT ["/usr/bin/tini", "--"]

# Migrations run from the api service on start, under an advisory lock (SRS §9), so
# scaling to several replicas cannot race two upgrades against each other.
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn netsecops.main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips='*'"]
