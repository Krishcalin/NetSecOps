# NetSecOps SPA: built with Node, served by Caddy (SEC-02 headers, SEC-10 non-root).

FROM node:22-alpine AS build

WORKDIR /build
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci --no-audit --no-fund

COPY frontend/ ./
RUN npm run build

# ──────────────────────────── runtime stage ────────────────────────────
FROM caddy:2-alpine AS runtime

COPY --from=build /build/dist /srv
COPY deploy/caddy/Caddyfile /etc/caddy/Caddyfile

# Caddy needs writable config/data dirs; give them to the unprivileged user.
RUN adduser -D -u 10001 netsecops \
    && mkdir -p /data /config \
    && chown -R 10001:10001 /data /config /srv

USER 10001:10001
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s \
    CMD wget -qO- http://127.0.0.1:8080/ >/dev/null || exit 1

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
