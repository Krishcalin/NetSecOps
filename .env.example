# NetSecOps environment template (SRS Appendix C).
#
# Copy to `.env` and fill in real values. Never commit `.env` (SEC-08).
#
# Generate the two keys below with:
#   cd backend && python -m netsecops.cli generate-secret-key
#   cd backend && python -m netsecops.cli generate-master-key

# ── Core ────────────────────────────────────────────────────────────────────
NETSECOPS_ENV=dev                  # dev | test | staging | prod
NETSECOPS_DEBUG=false
NETSECOPS_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR | CRITICAL
NETSECOPS_LOG_FORMAT=json          # json | console  (use `console` for local work)

# ── Database ────────────────────────────────────────────────────────────────
# Host port 5442 avoids colliding with any other local PostgreSQL on 5432.
DATABASE_URL=postgresql+asyncpg://netsecops:netsecops@localhost:5442/netsecops
POSTGRES_PASSWORD=netsecops

# ── Published host ports ────────────────────────────────────────────────────
# Change these if something else on the host already owns them.
DB_PORT=5442
API_PORT=8000
UI_PORT=8080

# ── Secrets ─────────────────────────────────────────────────────────────────
# SECRET_KEY signs JWTs. Rotating it invalidates every live session.
SECRET_KEY=

# MASTER_KEY wraps the data keys that protect stored device credentials
# (FR-CRED-02). LOSING THIS KEY MEANS LOSING EVERY STORED CREDENTIAL — back it up
# separately from the database, and never in the same place as a database dump.
NETSECOPS_MASTER_KEY_PROVIDER=env   # env | file | vault | awskms | azurekv | gcpkms
MASTER_KEY=
# MASTER_KEY_PATH=/run/secrets/netsecops_master_key

# ── Web tier (SEC-02, SEC-03) ───────────────────────────────────────────────
# Set COOKIE_SECURE=true whenever the app is served over HTTPS. Required in prod.
NETSECOPS_COOKIE_SECURE=false
NETSECOPS_COOKIE_SAMESITE=strict
NETSECOPS_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ── Authentication policy ───────────────────────────────────────────────────
NETSECOPS_ACCESS_TOKEN_TTL_MINUTES=15
NETSECOPS_REFRESH_TOKEN_TTL_HOURS=8
NETSECOPS_PASSWORD_MIN_LENGTH=12
NETSECOPS_PASSWORD_HISTORY=5
NETSECOPS_LOCKOUT_MAX_ATTEMPTS=5
NETSECOPS_LOCKOUT_DURATION_MINUTES=15
NETSECOPS_MFA_ISSUER=NetSecOps

# ── Device access (Phase 1 onward) ──────────────────────────────────────────
NETSECOPS_WORKER_CONCURRENCY=20
NETSECOPS_DEVICE_CONNECT_TIMEOUT=15
NETSECOPS_DEVICE_COMMAND_TIMEOUT=60
# Enabling legacy SSH ciphers is itself reported as a finding. Leave false.
NETSECOPS_ALLOW_LEGACY_SSH_CIPHERS=false

# ── Vulnerability feeds (Phase 6) ───────────────────────────────────────────
# All optional. An air-gapped installation sets FEEDS_OFFLINE_MODE=true and works
# entirely from imported bundles, so nothing here is required to start (FR-VUL-08, C-7).
NETSECOPS_FEEDS_OFFLINE_MODE=false
# NETSECOPS_NVD_API_KEY=

# Cisco PSIRT openVuln API (FR-VUL-02). Obtain the pair from https://apiconsole.cisco.com:
# register a new application, choose application type "Service" and grant type
# "Client Credentials", and select the Cisco PSIRT openVuln API. NetSecOps exchanges
# them at https://id.cisco.com/oauth2/default/v1/token for a one-hour bearer token.
#
# The client secret is a long-lived credential. Treat this file the way you treat
# MASTER_KEY: not in version control, readable only by the service account.
# CISCO_PSIRT_CLIENT_ID=
# CISCO_PSIRT_CLIENT_SECRET=

# ── Observability / audit ───────────────────────────────────────────────────
NETSECOPS_METRICS_ENABLED=true
NETSECOPS_AUDIT_RETENTION_DAYS=730
